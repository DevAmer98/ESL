# Copy to .env and fill in. Never commit .env.

# --- required ----------------------------------------------------------------

# Postgres connection. Use a pooled URL (PgBouncer/Neon/Supabase) if you deploy
# serverless; a direct URL is fine for a long-lived server.
DATABASE_URL="postgresql://user:password@localhost:5432/esl?schema=public"

# Encrypts the Minew API token at rest (AES-256-GCM). Any passphrase works — it
# is normalised to 32 bytes — but changing it makes every stored token
# undecryptable, so treat it as permanent. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=""

# --- optional ----------------------------------------------------------------

PORT=3000

# Background worker: drains the push queue, fires scheduled updates and
# reconciles device liveness. Set to "false" on every instance if you run more
# than one, and drive /api/jobs/tick from an external cron instead.
WORKER_ENABLED="true"
WORKER_TICK_MS=5000

# Shared secret for POST /api/jobs/tick, sent as `Authorization: Bearer <secret>`.
# Required whenever WORKER_ENABLED=false and an external cron drives the queue —
# the endpoint returns 503 rather than running unauthenticated if this is unset.
CRON_SECRET=

# --- first-run seed only -----------------------------------------------------
# Consumed by `npm run db:seed`. Set a real password before seeding production.
SEED_EMAIL="admin@example.com"
SEED_PASSWORD=""
SEED_STORE="My Store"
